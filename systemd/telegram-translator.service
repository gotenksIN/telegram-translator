[Unit]
Description=Telegram translate bot (Twitter/X previews + message translation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/telegram-translator
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/telegram-translator/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5s

# Resource limits
MemoryMax=256M
CPUQuota=100%

# Hardening
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
