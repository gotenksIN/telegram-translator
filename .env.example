# Copy this file to .env and fill in the values.

# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Gemini API key.
GEMINI_API_KEY=

# Gemini API Base URL (optional).
# Set this to send Gemini requests through a custom proxy URL.
# If not set, the default Gemini Developer API URL is used.
# GEMINI_API_BASE=

# Gemini model (optional).
# Defaults to gemini-3.5-flash if not set.
# GEMINI_MODEL=gemini-3.5-flash

# Translation target language.
# Defaults to English if not set.
# TARGET_LANGUAGE=English

# HTTP request timeout for preview page fetching.
# Defaults to 10 seconds if not set.
# REQUEST_TIMEOUT_SECONDS=10

# YouTube cookies file for yt-dlp (optional).
# Helps avoid bot detection on cloud/VPS instances.
# Export from browser: yt-dlp --cookies-from-browser edge --cookies youtube-cookies.txt
# YOUTUBE_COOKIES_PATH=youtube-cookies.txt
