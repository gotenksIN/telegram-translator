# Copy this file to .env and fill in the values.

# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram Bot API Base URL (optional).
# Set this to send Telegram API requests through a custom proxy URL (e.g. Cloudflare Worker).
# Do NOT include the trailing /bot.
# TELEGRAM_API_BASE_URL=

# Gemini API key.
GEMINI_API_KEY=

# Gemini API Base URL (optional).
# Set this to send Gemini requests through a custom proxy URL.
# If not set, the default Gemini Developer API URL is used.
# GEMINI_API_BASE=

# Gemini model (optional).
# Defaults to gemini-3.6-flash if not set.
# GEMINI_MODEL=gemini-3.6-flash

# Gemini thinking level (optional): minimal, low, medium, or high.
# Defaults to low if not set.
# GEMINI_THINKING_LEVEL=low

# Translation target language.
# Defaults to English if not set.
# TARGET_LANGUAGE=English

# HTTP request timeout for preview page fetching.
# Defaults to 10 seconds if not set.
# REQUEST_TIMEOUT_SECONDS=10

# Twitter/X preview host used for status URLs.
# Defaults to hitlerx.com if not set. Do not include https://.
# TWITTER_PREVIEW_HOST=hitlerx.com

# YouTube cookies file for yt-dlp (optional).
# Helps avoid bot detection on cloud/VPS instances.
# Export from browser: yt-dlp --cookies-from-browser edge --cookies youtube-cookies.txt
# YOUTUBE_COOKIES_PATH=youtube-cookies.txt
